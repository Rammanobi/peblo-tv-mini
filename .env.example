# Peblo TV Mini — environment variables
# Copy this file to `.env` for docker-compose, or source individual values into
# each service's own `.env` for local (non-docker) development.
# NOTHING in this file is a real secret — every value below is a placeholder.

# ---------------------------------------------------------------------------
# Postgres (used by docker-compose to boot the `postgres` service, and by the
# backend to build DATABASE_URL)
# ---------------------------------------------------------------------------
POSTGRES_USER=peblo
POSTGRES_PASSWORD=peblo_dev_password_change_me
POSTGRES_DB=peblo_tv

# ---------------------------------------------------------------------------
# Backend (FastAPI) — backend/
# ---------------------------------------------------------------------------

# Full SQLAlchemy/psycopg connection string. In docker-compose this is built
# from the POSTGRES_* vars above and points at the `postgres` service; set it
# explicitly when running the backend outside docker.
DATABASE_URL=postgresql://peblo:peblo_dev_password_change_me@localhost:5432/peblo_tv

# Symmetric secret used to sign/verify HS256 JWTs issued by POST /auth/login.
# Generate a real one for any non-local environment, e.g.: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-32-bytes-minimum

# Comma-separated list of origins allowed to call the API (CMS + Viewer dev/
# prod URLs). No trailing slashes.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Port the FastAPI/uvicorn process listens on inside its container.
PORT=4000

# Which storage backend serves uploaded artwork: "local" (disk, default for
# this challenge) or "s3" (S3-compatible object storage, e.g. AWS S3 or
# Cloudflare R2 via its S3-compatible endpoint).
STORAGE_DRIVER=local

# Used only when STORAGE_DRIVER=local: where uploaded files are written inside
# the api container (backed by the `api_storage` named volume in compose).
STORAGE_LOCAL_PATH=/data/storage

# Used only when STORAGE_DRIVER=s3. Leave blank for local storage.
S3_BUCKET=peblo-tv-artwork-dev
S3_REGION=auto
S3_ACCESS_KEY_ID=changeme-access-key-id
S3_SECRET_ACCESS_KEY=changeme-secret-access-key
# For AWS S3 leave this blank; for Cloudflare R2 (or MinIO/other S3-compatible
# stores) set it to that provider's endpoint, e.g.
# https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=

# Public base URL prepended to stored artwork keys when building the "url"
# field returned by the API (a CDN in front of the bucket, or the local
# static file mount in dev). Leave blank to fall back to STORAGE_LOCAL_PATH
# served directly by the API.
CDN_BASE_URL=http://localhost:4000/static

# ---------------------------------------------------------------------------
# CMS (React/Vite, editor & admin UI) — cms/
# These are build-time Vite vars: they must be set at `docker build` time
# (see cms/Dockerfile ARG/ENV) or in cms/.env for `npm run dev`.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Viewer (React/Vite, public catalogue UI) — viewer/
# ---------------------------------------------------------------------------
# Base URL for general API calls (currently unused beyond catalogue, kept for
# parity with the CMS and for future public endpoints).
VITE_API_URL=http://localhost:4000/api/v1

# Base URL the Viewer reads the published catalogue from: GET /catalog and
# GET /catalog/search. Defaults to VITE_API_URL when unset; split out here so
# the catalogue can later be served from a CDN/edge cache independent of the
# rest of the API.
VITE_CATALOGUE_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------------
# Ports (docker-compose host-side mappings; change here if they collide with
# something else already running on your machine)
# ---------------------------------------------------------------------------
API_PORT=4000
CMS_PORT=3000
VIEWER_PORT=3001
POSTGRES_PORT=5432
