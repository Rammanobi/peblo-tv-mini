# Base URL of the FastAPI backend (public catalogue endpoints only).
# The app calls "${VITE_API_URL}/catalog" and "${VITE_API_URL}/catalog/search".
VITE_API_URL=http://localhost:4000/api/v1

# Optional: override the catalogue base separately from the general API base.
# If unset, VITE_API_URL is used for the catalogue endpoints too.
# VITE_CATALOGUE_URL=http://localhost:4000/api/v1
